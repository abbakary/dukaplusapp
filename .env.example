# ── API (Railway production backend) ───────────────────────────────────────
# Direct URL — used by production builds and when not using Vite proxy:
VITE_API_BASE_URL=https://dukaplusbackend-production.up.railway.app/api/v1

# Local dev with Vite proxy (optional — uncomment both lines below):
# VITE_API_BASE_URL=/api/v1
# VITE_BACKEND_URL=https://dukaplusbackend-production.up.railway.app

# Local backend instead of Railway:
# VITE_API_BASE_URL=/api/v1
# VITE_BACKEND_URL=http://localhost:8000

# Ensure Railway backend CORS_ORIGINS includes your frontend origin, e.g.:
# http://localhost:5173,https://your-frontend.up.railway.app
